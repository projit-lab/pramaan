# Pramaan web lane environment.
#
# Copy this file to web/.env.local and fill it in. Vite reads .env.local for every
# workspace in web/ when the dev server starts from this directory.
#
# NEVER commit a filled-in .env file. The repository's .gitignore already ignores
# .env and .env.* while allowing .env.example.

# ---------------------------------------------------------------------------
# Local development: emulators and the mock API. These defaults need no Firebase
# project at all, so a fresh clone runs with no secrets.
# ---------------------------------------------------------------------------

# true routes Firebase Auth and Firestore at the local emulators.
VITE_USE_EMULATORS=true

# Base URL of the API. Point this at the Prism mock server while Prajit's API is
# still being built, then change this one value when his Cloud Run endpoint lands.
#   Prism mock:  http://127.0.0.1:4010
#   Cloud Run:   https://pramaan-api-<hash>-as.a.run.app/v1
VITE_API_BASE=http://127.0.0.1:4010

# Shows the demo control panel and presenter view in the console. Set true only in
# the dev and demo projects, never in production.
VITE_DEMO_MODE=true

# Where the public sandbox bank page reads payouts from.
#   api       - GET /payouts, no sign-in. Needs Prajit's endpoint. Preferred.
#   firestore - read payouts/{id} directly, which requires a signed-in clerk.
# See the open decision in contracts/firestore.md.
VITE_PAYOUTS_SOURCE=api

# Base URL of the public mandate verifier, so the console's "Verify this mandate"
# link points at it. A separate Firebase Hosting site, hence a separate value.
VITE_VERIFY_BASE=http://localhost:5175

# ---------------------------------------------------------------------------
# Firebase web config. Needed only when VITE_USE_EMULATORS=false, or for Google
# sign-in against the real project.
#
# Shoaib: paste these from the Firebase console, Project settings, "Your apps",
# web app config. They are not secrets (they ship in the browser bundle), but keep
# them out of git anyway so dev, demo and production never get mixed up.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emulator ports. Change only if they clash with something else on your laptop.
VITE_EMULATOR_AUTH_URL=http://127.0.0.1:9099
VITE_EMULATOR_FIRESTORE_HOST=127.0.0.1
VITE_EMULATOR_FIRESTORE_PORT=8080
