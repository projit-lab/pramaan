# Environment configuration for Pramaan API
ENV=local
GCP_PROJECT=pramaan-dev-515306
REGION=asia-south1
KMS_KEY=projects/pramaan-dev-515306/locations/asia-south1/keyRings/pramaan/cryptoKeys/mandate-signer
DEMO_MODE=false
ALLOW_TEST_SIGNER=false
# FIRESTORE_EMULATOR_HOST=localhost:8080
ATTEST_PATCH_WINDOW_MONTHS=12
ANDROID_SIGNING_SHA256=3313d44bb45e66849411470eeffa85a49a66bc9d1a9718a2463b98898d93d968

# AlloyDB (PostgreSQL). Leave unset with ENV=local to use .local/pramaan.db (SQLite).
# DATABASE_URL=postgresql+psycopg://pramaan:<password>@<host>:5432/pramaan
COMPANY_ID=co_acme
APPROVAL_TTL_HOURS=24

# Local demo switches (ENV=local only)
# USE_REAL_KMS_IN_LOCAL=true    # countersign with the real Cloud KMS HSM key via your gcloud ADC
# USE_FIRESTORE_IN_LOCAL=true   # write holds/devices/payouts to the real Firestore so the console shows them
